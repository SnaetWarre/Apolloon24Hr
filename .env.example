PORT=5173
PUBLIC_APP_PORT=5173
# Optional: set this if automatic LAN IP detection picks the wrong interface.
# PUBLIC_HOST=192.168.1.239

# Packaged Electron builds enable laptop coupling (primary/standby) automatically.
# CLUSTER_ENABLED=true

# Verified SQLite backups. Production defaults are shown here.
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_MS=300000
# BACKUP_INITIAL_DELAY_MS=10000
# BACKUP_MIN_FREE_BYTES=2147483648
