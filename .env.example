PORT=5173
PUBLIC_APP_PORT=5173
# Optional: set this if automatic LAN IP detection picks the wrong interface.
# Leave PUBLIC_HOST and CLUSTER_SELF_URL unset to follow laptop IP changes.
# PUBLIC_HOST=192.168.1.239
# Additional DNS names used to access the app, without scheme or port.
# Literal IPs, localhost, the machine hostname and PUBLIC_HOST are allowed.
# APOLLOON_ALLOWED_HOSTS=apolloon.example.org,timing-laptop.local

# Packaged Electron builds enable the LAN cluster automatically.
# CLUSTER_ENABLED=true
# CLUSTER_DISCOVERY=true
# TIMING_TAKEOVER_GRACE_MS=10000
# TIMING_FORCED_TAKEOVER_GRACE_MS=30000
# Compatibility ranges are emitted automatically. Override only for a planned
# rolling upgrade whose migrations and replicated SQL have been reviewed.
# APOLLOON_APP_VERSION=2.0.0
# APOLLOON_MIN_COMPATIBLE_APP_VERSION=2.0.0

# Verified online SQLite backups. Production defaults are shown here.
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_MS=300000
# BACKUP_INITIAL_DELAY_MS=10000
# BACKUP_MIN_FREE_BYTES=2147483648
# BACKUP_MAX_TOTAL_BYTES=8589934592

# SQLite compaction only runs automatically while no race is active.
# DATABASE_COMPACTION_MIN_BYTES=16777216
# DATABASE_COMPACTION_MIN_RATIO=0.25
