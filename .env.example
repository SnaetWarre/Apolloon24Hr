PORT=5173
PUBLIC_APP_PORT=5173
# Optional: set this if automatic LAN IP detection picks the wrong interface.
# PUBLIC_HOST=192.168.1.239

# Packaged Electron builds enable the LAN cluster automatically.
# CLUSTER_ENABLED=true
# CLUSTER_DISCOVERY=true
# TIMING_TAKEOVER_GRACE_MS=10000
# TIMING_FORCED_TAKEOVER_GRACE_MS=30000

# Verified online SQLite backups. Production defaults are shown here.
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_MS=300000
# BACKUP_INITIAL_DELAY_MS=10000
