@@ -0,0 +1,67 @@
+use super::AppHandle;
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+pub(crate) type Report = Arc<dyn Fn(&'static str) + Send + Sync>;
+
+pub(crate) struct Pending {
+    enabled: bool,
+    reports: Mutex<Vec<Report>>,
+}
+
+impl Default for Pending {
+    fn default() -> Self {
+        Self::new(enabled(std::env::var("APOLLOON_ACK_DRAW").ok().as_deref()))
+    }
+}
+
+fn enabled(value: Option<&str>) -> bool { value != Some("0") }
+
+impl Pending {
+    fn new(enabled: bool) -> Self { Self { enabled, reports: Mutex::default() } }
+
+    pub(crate) fn request(&self, report: Report) {
+        if self.enabled {
+            self.reports.lock().unwrap().push(report);
+        }
+    }
+
+    pub(crate) fn waiting(&self) -> bool { !self.reports.lock().unwrap().is_empty() }
+
+    #[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+    pub(crate) fn admit(&self, waiting: bool, last_target: &mut Option<Instant>, now: Instant) -> bool {
+        if waiting && !self.reports.lock().unwrap().is_empty() {
+            *last_target = Some(now);
+            true
+        } else { false }
+    }
+
+    pub(crate) fn begin(&self) -> Frame {
+        let frame = Frame(std::mem::take(&mut *self.reports.lock().unwrap()));
+        for report in &frame.0 { report("ack_draw_build"); }
+        frame
+    }
+}
+
+pub(crate) struct Frame(Vec<Report>);
+
+impl Frame {
+    pub(crate) fn presented(self) {
+        for report in self.0 { report("ack_draw_present"); }
+    }
+}
+
+impl<S: 'static> AppHandle<S> {
+    /// Queues one draw admission for a confirmed save answer. Ordinary wakes stay paced.
+    /// The report follows this request from enqueue to build and successful present return.
+    /// Only exact `APOLLOON_ACK_DRAW=0` disables admission; wake delivery is unchanged.
+    pub fn ack_draw(&self, report: impl Fn(&'static str) + Send + Sync + 'static) {
+        let report: Report = Arc::new(report);
+        if self.shared.core.ack_draw.enabled { report("ack_draw_enqueue"); }
+        self.shared.core.request_ack_draw(report);
+    }
+}
+
+#[cfg(test)]
+#[path = "ack_draw_tests.rs"]
+mod tests;
