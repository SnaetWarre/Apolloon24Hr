+use super::*;
+
+#[test]
+fn parser_requires_one_and_rejects_absent_empty_zero_or_invalid() {
+    for value in [None, Some(""), Some("0"), Some("2"), Some("-1"), Some("true"), Some(" 1"), Some("4294967296")] {
+        assert!(!parse(value), "{value:?}");
+    }
+    assert!(parse(Some("1")));
+}
+
+#[test]
+fn disabled_requests_and_unrequested_frames_never_override_wait() {
+    let now = Instant::now();
+    for enabled in [false, true] {
+        let pending = Pending::new(enabled);
+        let mut last = None;
+        assert!(!pending.admit(true, &mut last, now));
+        assert_eq!(last, None);
+        if !enabled {
+            pending.request();
+            assert!(!pending.admit(true, &mut last, now));
+            assert_eq!(last, None);
+        }
+    }
+}
+
+#[test]
+fn repeated_sends_coalesce_and_only_the_next_wait_is_overridden() {
+    let pending = Pending::new(true);
+    let now = Instant::now();
+    let mut last = None;
+    for _ in 0..10 { pending.request(); }
+    assert!(pending.admit(true, &mut last, now));
+    assert_eq!(last, Some(now));
+    assert!(!pending.admit(true, &mut last, now));
+    pending.request();
+    assert!(pending.admit(true, &mut last, now));
+}
+
+#[test]
+fn naturally_admitted_frame_consumes_urgency_without_changing_target() {
+    let pending = Pending::new(true);
+    let now = Instant::now();
+    let target = now + std::time::Duration::from_millis(16);
+    let mut last = Some(target);
+    pending.request();
+    assert!(!pending.admit(false, &mut last, now));
+    assert_eq!(last, Some(target));
+    assert!(!pending.admit(true, &mut last, now));
+}
+
+#[test]
+fn covered_or_unpaced_poll_clears_urgency_but_later_sends_still_qualify() {
+    let pending = Pending::new(true);
+    let now = Instant::now();
+    let mut last = None;
+    pending.request();
+    pending.clear();
+    assert!(!pending.admit(true, &mut last, now));
+    pending.request();
+    assert!(pending.admit(true, &mut last, now));
+}
+
+#[test]
+fn ordinary_wakes_do_not_mark_state_urgent() {
+    let spec = crate::AppSpec::new("test", (100.0, 100.0), || (), |_, _| crate::text("test"));
+    let app = crate::App::new(spec);
+    let handle = app.handle();
+    let pending = &handle.shared.urgent_state;
+    let mut last = None;
+    handle.wake();
+    assert!(!pending.admit(true, &mut last, Instant::now()));
+}
+
+#[test]
+fn only_qualified_waker_requests_urgent_admission() {
+    for enabled in [false, true] {
+        let mut shared = super::super::Shared::<()>::default();
+        shared.urgent_state = Pending::new(enabled);
+        let handle = AppHandle { shared: Arc::new(shared) };
+        let wake = handle.urgent_state_waker();
+        assert_eq!(wake.is_some(), enabled);
+        if let Some(wake) = wake {
+            for _ in 0..10 { wake(); }
+            assert!(handle.shared.take().woken);
+            let mut last = None;
+            assert!(handle.shared.urgent_state.admit(true, &mut last, Instant::now()));
+            handle.wake();
+            assert!(!handle.shared.urgent_state.admit(true, &mut last, Instant::now()));
+        }
+    }
+}
+
+#[test]
+fn b4_4_ordinary_duplicate_and_recovery_wakes_admit_exactly_one_urgent_frame() {
+    let mut shared = super::super::Shared::<()>::default();
+    shared.urgent_state = Pending::new(true);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    let request = handle.urgent_state_waker().unwrap();
+    let now = Instant::now();
+    let mut last = None;
+    request();
+    let mut admissions = 0;
+    for delivery in 0..3 {
+        if delivery > 0 { handle.wake(); }
+        admissions += usize::from(handle.shared.urgent_state.admit(true, &mut last, now));
+    }
+    assert_eq!(admissions, 1);
+    assert_eq!(last, Some(now));
+    assert!(!handle.shared.urgent_state.admit(true, &mut last, now));
+}
