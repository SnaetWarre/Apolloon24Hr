diff --git a/crates/rune/src/tooling/text_setup_tests.rs b/crates/rune/src/tooling/text_setup_tests.rs
new file mode 100644
index 000000000..49db564d5
--- /dev/null
+++ b/crates/rune/src/tooling/text_setup_tests.rs
@@ -0,0 +1,47 @@
+use super::*;
+
+const SAMPLE: &str = "Setup measurement";
+
+fn style() -> crate::TextStyle {
+    crate::TextStyle::new(13.5, 700.0)
+}
+
+fn spec() -> AppSpec<()> {
+    AppSpec::new("text setup", (100.0, 100.0), || (), |_, _| crate::el())
+}
+
+fn runtime(spec: &AppSpec<()>) -> Runtime<()> {
+    runtime_for(spec, (), spec.size, Env::default(), std::sync::Arc::new(|| {}))
+}
+
+#[test]
+fn setup_measurements_warm_the_windows_text_cache() {
+    let mut spec = spec();
+    spec.setup = Some(|_, _| {
+        let size = crate::text::measure(SAMPLE, &[], style(), None);
+        assert!(size.0 > 0.0 && size.1 > 0.0, "setup measurement failed: {size:?}");
+    });
+
+    let mut warmed = runtime(&spec);
+    assert_eq!(warmed.text.shaped, 1, "setup did not shape on the window's text system");
+    warmed.text.layout_rich(SAMPLE, &[], style(), 1.0, None);
+    assert_eq!(warmed.text.shaped, 1, "the setup layout belongs to this window");
+}
+
+#[test]
+fn absent_and_empty_setup_do_not_shape_text() {
+    let mut spec = spec();
+    assert_eq!(runtime(&spec).text.shaped, 0);
+    spec.setup = Some(|_, _| {});
+    assert_eq!(runtime(&spec).text.shaped, 0);
+}
+
+#[test]
+fn panicking_setup_restores_the_measurement_context() {
+    let mut spec = spec();
+    spec.setup = Some(|_, _| panic!("setup failed"));
+    assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| runtime(&spec))).is_err());
+
+    let size = crate::text::measure("after setup", &[], crate::TextStyle::new(14.0, 400.0), None);
+    assert!(size.0 > 0.0 && size.1 > 0.0);
+}
