+/// Installs or clears this thread's frame-stage hook. `rune` uses this to forward narrow text
+/// work stages to a window's own frame tracer; with no hook installed a `FrameStage` is only
+/// a thread-local read and a branch.
+#[doc(hidden)]
+pub fn set_frame_stage_hook(hook: Option<fn(&'static str)>) {
+    FRAME_STAGE.set(hook);
