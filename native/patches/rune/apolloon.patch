+use crate::Runtime;
+
+pub(super) fn enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| parse(std::env::var("APOLLOON_IMMEDIATE_INPUT").ok().as_deref()))
+}
+
+fn parse(value: Option<&str>) -> bool { value == Some("1") }
+
+pub(super) fn dispatch<S: 'static>(rt: &mut Runtime<S>, enabled: bool) -> bool {
+    if !enabled || !rt.keys_queued() { return false; }
+    rt.hidden_timer_frame();
+    true
+}
