+use super::*;
+use std::{cell::RefCell, rc::Rc};
+
+#[test]
+fn runtime_scopes_use_only_the_current_windows_hook() {
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let events = seen.clone();
+    let mut reports = crate::frame::encoded::FrameReports::<()>::default()
+        .staging(Some(Box::new(move |stage| events.borrow_mut().push(stage))));
+    reports.stage("runtime_begin");
+    {
+        let _view = Scope::new(Phase::View);
+        let _text = Scope::new(Phase::Text);
+    }
+    reports.stage("runtime_end");
+    drop(Scope::new(Phase::Paint));
+    assert_eq!(*seen.borrow(), ["runtime_begin", "view_begin", "text_begin", "text_end", "view_end", "runtime_end"]);
+}
+
+#[test]
+fn untraced_runtime_scopes_have_no_hook() {
+    stage_hook(None);
+    assert!(TraceScope::new("glyph_begin", "glyph_end").0.is_none());
+}
+
+#[test]
+fn an_empty_runtime_clears_its_hook() {
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let events = seen.clone();
+    let mut reports = crate::frame::encoded::FrameReports::<()>::default()
+        .staging(Some(Box::new(move |stage| events.borrow_mut().push(stage))));
+    reports.stage("runtime_begin");
+    reports.stage("runtime_end");
+    assert!(TraceScope::new("atlas_begin", "atlas_end").0.is_none());
+    assert_eq!(*seen.borrow(), ["runtime_begin", "runtime_end"]);
+}
