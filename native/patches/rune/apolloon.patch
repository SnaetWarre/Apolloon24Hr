+pub use rune_core::marks::*;
+
+static WINDOW_KEY: std::sync::OnceLock<fn(&crate::KeyEvent, bool, bool)> = std::sync::OnceLock::new();
+static WINDOW_FOCUS: std::sync::OnceLock<fn(bool)> = std::sync::OnceLock::new();
+
+/// Observes native key receipt before routing, with repeat and control-focus flags.
+pub fn on_window_key(hook: fn(&crate::KeyEvent, bool, bool)) {
+    let _ = WINDOW_KEY.set(hook);
+}
+
+/// Observes native window focus changes.
+pub fn on_window_focus(hook: fn(bool)) {
+    let _ = WINDOW_FOCUS.set(hook);
+}
+
+pub(crate) fn window_key(event: &crate::KeyEvent, repeat: bool, control_focused: bool) {
+    if let Some(hook) = WINDOW_KEY.get() { hook(event, repeat, control_focused) }
+}
+
+pub(crate) fn window_focus(focused: bool) {
+    if let Some(hook) = WINDOW_FOCUS.get() { hook(focused) }
+}
