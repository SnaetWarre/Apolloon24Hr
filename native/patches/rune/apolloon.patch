+use super::*;
+
+#[test]
+fn parser_requires_one_and_rejects_absent_empty_zero_or_invalid() {
+    for value in [None, Some(""), Some("0"), Some("2"), Some("-1"), Some("true"), Some(" 1"), Some("4294967296")] {
+        assert!(!parse(value), "{value:?}");
+    }
+    assert!(parse(Some("1")));
+}
+
+#[test]
+fn disabled_requests_and_unrequested_frames_never_override_wait() {
+    for enabled in [false, true] {
+        let pending = Pending::new(enabled);
+        assert!(!pending.admit(true));
+        if !enabled {
+            pending.request();
+            assert!(!pending.admit(true));
+        }
+    }
+}
+
+#[test]
+fn repeated_sends_coalesce_and_only_the_next_wait_is_overridden() {
+    let pending = Pending::new(true);
+    for _ in 0..10 { pending.request(); }
+    assert!(pending.admit(true));
+    assert!(!pending.admit(true));
+    pending.request();
+    assert!(pending.admit(true));
+}
+
+#[test]
+fn naturally_admitted_frame_consumes_urgency() {
+    let pending = Pending::new(true);
+    pending.request();
+    assert!(!pending.admit(false));
+    assert!(!pending.admit(true));
+}
+
+#[test]
+fn covered_or_unpaced_poll_clears_urgency_but_later_sends_still_qualify() {
+    let pending = Pending::new(true);
+    pending.request();
+    pending.clear();
+    assert!(!pending.admit(true));
+    pending.request();
+    assert!(pending.admit(true));
+}
+
+#[test]
+fn ordinary_wakes_do_not_mark_state_urgent() {
+    let spec = crate::AppSpec::new("test", (100.0, 100.0), || (), |_, _| crate::text("test"));
+    let app = crate::App::new(spec);
+    let handle = app.handle();
+    let pending = &handle.shared.urgent_state;
+    handle.wake();
+    assert!(!pending.admit(true));
+}
+
+#[test]
+fn only_qualified_waker_requests_urgent_admission() {
+    for enabled in [false, true] {
+        let mut shared = super::super::Shared::<()>::default();
+        Arc::get_mut(&mut shared.core).unwrap().urgent_state = Pending::new(enabled);
+        let handle = AppHandle { shared: Arc::new(shared) };
+        let wake = handle.urgent_state_waker();
+        assert_eq!(wake.is_some(), enabled);
+        if let Some(wake) = wake {
+            for _ in 0..10 { wake(); }
+            assert!(handle.shared.take().woken);
+            assert!(handle.shared.urgent_state.admit(true));
+            handle.wake();
+            assert!(!handle.shared.urgent_state.admit(true));
+        }
+    }
+}
+
+#[test]
+fn ordinary_duplicate_and_recovery_wakes_admit_exactly_one_urgent_frame() {
+    let mut shared = super::super::Shared::<()>::default();
+    Arc::get_mut(&mut shared.core).unwrap().urgent_state = Pending::new(true);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    let request = handle.urgent_state_waker().unwrap();
+    request();
+    let mut admissions = 0;
+    for delivery in 0..3 {
+        if delivery > 0 { handle.wake(); }
+        admissions += usize::from(handle.shared.urgent_state.admit(true));
+    }
+    assert_eq!(admissions, 1);
+    assert!(!handle.shared.urgent_state.admit(true));
+}
