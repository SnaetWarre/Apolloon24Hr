+use super::AppHandle;
+use std::sync::{Arc, atomic::{AtomicBool, Ordering}};
+use std::time::Instant;
+
+pub(crate) struct Pending(Option<AtomicBool>);
+
+impl Default for Pending {
+    fn default() -> Self {
+        Self::new(parse(std::env::var("APOLLOON_URGENT_STATE_FRAME").ok().as_deref()))
+    }
+}
+
+impl Pending {
+    fn new(enabled: bool) -> Self { Self(enabled.then(|| AtomicBool::new(false))) }
+
+    fn request(&self) {
+        if let Some(pending) = &self.0 { pending.store(true, Ordering::Release); }
+    }
+
+    pub(crate) fn clear(&self) {
+        if let Some(pending) = &self.0 { pending.store(false, Ordering::Release); }
+    }
+
+    #[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+    pub(crate) fn admit(&self, waiting: bool, last_target: &mut Option<Instant>, now: Instant) -> bool {
+        let pending = self.0.as_ref().is_some_and(|pending| pending.swap(false, Ordering::AcqRel));
+        if waiting && pending {
+            *last_target = Some(now);
+            true
+        } else { false }
+    }
+}
+
+fn parse(value: Option<&str>) -> bool {
+    value.and_then(|value| value.parse::<u32>().ok()) == Some(1)
+}
+
+impl<S: 'static> AppHandle<S> {
+    /// Wake the event loop so `AppSpec::poll` runs, also while the window is hidden; for a
+    /// background thread that queued work for `poll` to drain.
+    pub fn wake(&self) {
+        self.request(|q| q.woken = true);
+    }
+
+    /// A wake for queued authoritative state, with one-shot immediate Metal admission when
+    /// `APOLLOON_URGENT_STATE_FRAME=1`. Other wakes and subsequent animation frames stay paced.
+    /// Returns `None` when the experiment is disabled. Create before running the app.
+    pub fn urgent_state_waker(&self) -> Option<crate::runtime::Waker> {
+        self.shared.urgent_state.0.as_ref()?;
+        let handle = self.clone();
+        Some(Arc::new(move || {
+            handle.shared.urgent_state.request();
+            handle.wake();
+        }))
+    }
+}
+
