+use super::*;
+
+fn reports() -> (Report, Arc<Mutex<Vec<&'static str>>>) {
+    let stages = Arc::new(Mutex::new(Vec::new()));
+    let recorded = stages.clone();
+    (Arc::new(move |stage| recorded.lock().unwrap().push(stage)), stages)
+}
+
+#[test]
+fn only_exact_zero_opts_out() {
+    assert!(!enabled(Some("0")));
+    for value in [None, Some(""), Some("1"), Some("false"), Some("00"), Some(" 0")] {
+        assert!(enabled(value), "{value:?}");
+    }
+}
+
+#[test]
+fn confirmed_request_is_consumed_by_one_frame_and_reports_its_boundaries() {
+    let pending = Pending::new(true);
+    let (report, stages) = reports();
+    let now = Instant::now();
+    let mut last = None;
+    assert!(!pending.admit(true, &mut last, now));
+    pending.request(report);
+    assert!(pending.admit(true, &mut last, now));
+    assert_eq!(last, Some(now));
+    let frame = pending.begin();
+    assert!(!pending.admit(true, &mut last, now));
+    frame.presented();
+    pending.begin().presented();
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_build", "ack_draw_present"]);
+}
+
+#[test]
+fn naturally_admitted_frame_consumes_all_coalesced_requests_without_an_extra_frame() {
+    let pending = Pending::new(true);
+    let (first, a) = reports();
+    let (second, b) = reports();
+    pending.request(first);
+    pending.request(second);
+    let now = Instant::now();
+    let mut last = Some(now);
+    assert!(!pending.admit(false, &mut last, now));
+    pending.begin().presented();
+    assert!(!pending.admit(true, &mut last, now));
+    assert_eq!(*a.lock().unwrap(), *b.lock().unwrap());
+    assert_eq!(a.lock().unwrap().len(), 2);
+}
+
+#[test]
+fn ordinary_state_wakes_do_not_request_ack_admission() {
+    let mut shared = super::super::Shared::<()>::default();
+    Arc::get_mut(&mut shared.core).unwrap().ack_draw = Pending::new(true);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    handle.wake();
+    assert!(!handle.shared.ack_draw.admit(true, &mut None, Instant::now()));
+}
+
+#[test]
+fn opt_out_preserves_wake_without_admission_or_reports() {
+    let mut shared = super::super::Shared::<()>::default();
+    Arc::get_mut(&mut shared.core).unwrap().ack_draw = Pending::new(false);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    let (report, stages) = reports();
+    handle.ack_draw(move |stage| report(stage));
+    assert!(handle.shared.take().woken);
+    assert!(!handle.shared.ack_draw.admit(true, &mut None, Instant::now()));
+    handle.shared.ack_draw.begin().presented();
+    assert!(stages.lock().unwrap().is_empty());
+}
+
+#[test]
+fn admission_publishes_poll_work_before_a_frame_can_drain_the_request() {
+    let mut shared = super::super::Shared::<()>::default();
+    Arc::get_mut(&mut shared.core).unwrap().ack_draw = Pending::new(true);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    let stages = Arc::new(Mutex::new(Vec::new()));
+    let recorded = stages.clone();
+    let (sender, receiver) = std::sync::mpsc::channel();
+    let requests = handle.shared.core.requests.lock().unwrap();
+    let worker_handle = handle.clone();
+    let worker = std::thread::spawn(move || {
+        worker_handle.ack_draw(move |stage| {
+            recorded.lock().unwrap().push(stage);
+            if stage == "ack_draw_enqueue" { sender.send(()).unwrap(); }
+        });
+    });
+    receiver.recv_timeout(std::time::Duration::from_secs(10)).unwrap();
+    assert!(handle.shared.ack_draw.begin().0.is_empty());
+    drop(requests);
+    worker.join().unwrap();
+    assert!(handle.shared.take().woken);
+    handle.shared.ack_draw.begin().presented();
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_enqueue", "ack_draw_build", "ack_draw_present"]);
+}
+
+#[test]
+fn ack_during_a_build_belongs_to_the_next_frame() {
+    let pending = Pending::new(true);
+    let (report, stages) = reports();
+    let previous = pending.begin();
+    pending.request(report);
+    previous.presented();
+    assert!(stages.lock().unwrap().is_empty());
+    assert!(pending.admit(true, &mut None, Instant::now()));
+    pending.begin().presented();
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_build", "ack_draw_present"]);
+}
+
+#[test]
+fn missed_frame_never_claims_a_present_or_rearms_admission() {
+    let pending = Pending::new(true);
+    let (report, stages) = reports();
+    pending.request(report);
+    drop(pending.begin());
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_build"]);
+    assert!(!pending.admit(true, &mut None, Instant::now()));
+}
+
+#[test]
+fn waiting_is_visible_until_a_frame_takes_the_request() {
+    let pending = Pending::new(true);
+    assert!(!pending.waiting());
+    let (report, _) = reports();
+    pending.request(report);
+    assert!(pending.waiting());
+    drop(pending.begin());
+    assert!(!pending.waiting());
+}
