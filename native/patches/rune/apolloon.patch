@@ -0,0 +1,124 @@
+use super::*;
+
+fn quad(x: f32) -> Instance {
+    Instance { rect: [x, 20.0, 10.0, 20.0], clip: [0.0, 0.0, 200.0, 200.0], ..bytemuck::Zeroable::zeroed() }
+}
+
+#[test]
+fn ordinary_frames_track_insertions_removals_and_unchanged_instances() {
+    let mut damage = Damage::default();
+    let clear = [0.0, 0.0, 0.0, 1.0];
+    let a = quad(20.0);
+    assert!(matches!(damage.plan(&[a], (200, 200), clear, true), Plan::All(_)));
+    for next in [vec![a, quad(60.0)], vec![a], vec![a]] {
+        assert!(matches!(damage.plan(&next, (200, 200), clear, true), Plan::Part { .. }));
+    }
+}
+
+#[test]
+fn reset_resize_colour_and_external_paint_require_whole_frames() {
+    let mut damage = Damage::default();
+    let clear = [0.0, 0.0, 0.0, 1.0];
+    damage.plan(&[], (200, 200), clear, true);
+    assert!(matches!(damage.plan(&[], (300, 200), clear, true), Plan::All(_)));
+    assert!(matches!(damage.plan(&[], (300, 200), [1.0; 4], true), Plan::All(_)));
+    assert!(matches!(damage.plan(&[], (300, 200), [1.0; 4], false), Plan::All(_)));
+    damage.reset();
+    assert!(matches!(damage.plan(&[], (300, 200), [1.0; 4], true), Plan::All(_)));
+}
+
+#[test]
+fn reordering_shared_instances_requires_a_whole_frame() {
+    let mut damage = Damage::default();
+    let clear = [0.0, 0.0, 0.0, 1.0];
+    damage.plan(&[quad(20.0), quad(60.0)], (200, 200), clear, true);
+    assert_eq!(damage.plan(&[quad(60.0), quad(20.0)], (200, 200), clear, true), Plan::All("reordered"));
+}
+
+#[test]
+fn retained_frames_match_whole_frames_pixel_for_pixel() {
+    retained_match(crate::render::OFFSCREEN_FORMAT, true);
+}
+
+#[test]
+fn blitted_frames_match_whole_frames_pixel_for_pixel() {
+    for format in [wgpu::TextureFormat::Rgba8Unorm, wgpu::TextureFormat::Rgba8UnormSrgb,
+        wgpu::TextureFormat::Bgra8Unorm, wgpu::TextureFormat::Bgra8UnormSrgb] {
+        retained_match(format, false);
+    }
+}
+
+fn retained_match(format: wgpu::TextureFormat, copies: bool) {
+    retained_formats_match(&[format], format, copies);
+}
+
+#[test]
+fn retained_frames_rebuild_after_linear_and_srgb_view_switches() {
+    for copies in [true, false] {
+        retained_formats_match(&[wgpu::TextureFormat::Rgba8Unorm, wgpu::TextureFormat::Rgba8UnormSrgb,
+            wgpu::TextureFormat::Rgba8Unorm], wgpu::TextureFormat::Rgba8UnormSrgb, copies);
+    }
+}
+
+fn retained_formats_match(formats: &[wgpu::TextureFormat], surface_format: wgpu::TextureFormat, copies: bool) {
+    use crate::render::{Gpu, Offscreen, Renderer};
+    let gpu = Gpu::headless();
+    let mut partial = Renderer::new(&gpu.device, formats[0]);
+    let mut whole = Renderer::new(&gpu.device, formats[0]);
+    let mut atlas = crate::text::TextSystem::default().atlas;
+    let texture = gpu.device.create_texture(&wgpu::TextureDescriptor {
+        label: None, size: wgpu::Extent3d { width: 128, height: 128, depth_or_array_layers: 1 },
+        mip_level_count: 1, sample_count: 1, dimension: wgpu::TextureDimension::D2,
+        format: surface_format, usage: wgpu::TextureUsages::COPY_SRC | wgpu::TextureUsages::RENDER_ATTACHMENT
+            | if copies { wgpu::TextureUsages::COPY_DST } else { wgpu::TextureUsages::empty() },
+        view_formats: &[surface_format.remove_srgb_suffix(), surface_format.add_srgb_suffix()],
+    });
+    let buffer = gpu.device.create_buffer(&wgpu::BufferDescriptor {
+        label: None, size: 128 * 128 * 4, usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ, mapped_at_creation: false,
+    });
+    let mut damage = Damage::default();
+    let clear = [0.12, 0.2, 0.3, 1.0];
+    let mut a = quad(20.0);
+    a.fill = [0.8, 0.1, 0.2, 0.7];
+    let mut b = quad(25.0);
+    b.fill = [0.1, 0.8, 0.2, 0.6];
+    for &format in formats {
+        partial.set_format(&gpu.device, format);
+        whole.set_format(&gpu.device, format);
+        partial.set_srgb_blend(!format.is_srgb());
+        whole.set_srgb_blend(!format.is_srgb());
+        let target = Offscreen::with_format(&gpu.device, 128, 128, format);
+        let view = texture.create_view(&wgpu::TextureViewDescriptor { format: Some(format), ..Default::default() });
+        let mut frames = vec![vec![a], vec![a, b], vec![b], vec![b], vec![], vec![a, b], vec![b, a]];
+        let ramp: Vec<_> = (0..256).map(|n| {
+            let value = n as f32 / 255.0;
+            let value = if format.is_srgb() { crate::color::srgb_decode(value) } else { value };
+            Instance { rect: [(n % 128) as f32, 50.0 + (n / 128) as f32, 1.0, 1.0], fill: [value, value, value, 1.0], ..quad(0.0) }
+        }).collect();
+        frames.extend([ramp.clone(), ramp]);
+        for instances in frames {
+            let plan = damage.plan(&instances, (128, 128), clear, true);
+            if let Plan::Part { draw, .. } = &plan {
+                partial.arm_damage(&gpu.device, &gpu.queue, draw, clear, (128, 128), surface_format);
+            }
+            partial.prepare(&gpu.device, &gpu.queue, &mut atlas, &instances, (128, 128));
+            whole.prepare(&gpu.device, &gpu.queue, &mut atlas, &instances, (128, 128));
+            let mut encoder = gpu.device.create_command_encoder(&Default::default());
+            partial.draw(&mut encoder, &view, clear);
+            whole.draw(&mut encoder, &target.view, clear);
+            target.copy(&mut encoder);
+            encoder.copy_texture_to_buffer(texture.as_image_copy(), wgpu::TexelCopyBufferInfo { buffer: &buffer,
+                layout: wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(512), rows_per_image: Some(128) } },
+                wgpu::Extent3d { width: 128, height: 128, depth_or_array_layers: 1 });
+            let drawn = partial.damage_drawn();
+            if matches!(plan, Plan::Part { .. }) { assert!(drawn.is_ok()); }
+            partial.submit(&gpu.queue, encoder);
+            let expected = target.read(&gpu.device);
+            let slice = buffer.slice(..);
+            slice.map_async(wgpu::MapMode::Read, |r| r.unwrap());
+            gpu.device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+            assert_eq!(&*slice.get_mapped_range().unwrap(), &expected);
+            buffer.unmap();
+        }
+    }
+}
