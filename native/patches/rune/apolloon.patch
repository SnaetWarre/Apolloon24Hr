+use super::*;
+use crate::{Cx, El, Env, Ime, Key, KeyEvent, Mods, PhysicalInput, PhysicalKeyCode, TextEdit, TextStyle, el, text_input};
+
+#[derive(Default)]
+struct State { keys: usize, releases: usize, edit: TextEdit }
+
+fn view(_: &State, _: &mut Cx<State>) -> El {
+    el().on_key_up(|s: &mut State, _, _| { s.releases += 1; true })
+}
+
+fn runtime() -> Runtime<State> {
+    let mut rt = Runtime::new(State::default(), view, (300.0, 100.0), Env::new(true, 1.0));
+    rt.on_key = Some(|s, _, _| { s.keys += 1; true });
+    rt.frame(0.0);
+    rt
+}
+
+fn space(rt: &mut Runtime<State>, pressed: bool, repeat: bool) {
+    rt.physical_with_fallback(PhysicalInput::Key {
+        key: PhysicalKeyCode::Space, mods: Mods::default(), pressed, repeat,
+    }, Some(KeyEvent { key: Key::Text(" ".into()), mods: Mods::default() }));
+}
+
+#[test]
+fn only_exactly_one_enables_immediate_input() {
+    assert!(parse(Some("1")));
+    for value in [None, Some(""), Some("0"), Some("2"), Some("01"), Some("true"), Some(" 1")] {
+        assert!(!parse(value));
+    }
+}
+
+#[test]
+fn early_dispatched_key_is_handled_once_across_the_frame_drain() {
+    let mut rt = runtime();
+    space(&mut rt, true, false);
+    assert_eq!(rt.state.keys, 0);
+    assert!(dispatch(&mut rt, true));
+    assert_eq!(rt.state.keys, 1);
+    assert!(!rt.keys_queued());
+    assert!(!dispatch(&mut rt, true));
+    rt.frame(1.0 / 60.0);
+    assert_eq!(rt.state.keys, 1);
+}
+
+#[test]
+fn disabled_dispatch_leaves_input_for_the_frame() {
+    let mut rt = runtime();
+    space(&mut rt, true, false);
+    assert!(!dispatch(&mut rt, false));
+    assert_eq!(rt.state.keys, 0);
+    assert!(rt.keys_queued());
+    rt.frame(0.0);
+    assert_eq!(rt.state.keys, 1);
+}
+
+#[test]
+fn empty_dispatch_does_not_poll_or_run_a_frame() {
+    let mut rt = runtime();
+    rt.poll = Some(|_, _, _| panic!("empty input must not poll"));
+    assert!(!dispatch(&mut rt, true));
+}
+
+#[test]
+fn repeats_and_releases_keep_the_normal_routing_once_each() {
+    let mut early = runtime();
+    let mut paced = runtime();
+    for (pressed, repeat) in [(true, false), (true, true), (false, false)] {
+        for rt in [&mut early, &mut paced] { space(rt, pressed, repeat); }
+        assert!(dispatch(&mut early, true));
+        paced.frame(0.0);
+        assert_eq!((early.state.keys, early.state.releases), (paced.state.keys, paced.state.releases));
+    }
+    assert_eq!((early.state.keys, early.state.releases), (2, 1));
+    early.frame(0.0);
+    assert_eq!((early.state.keys, early.state.releases), (2, 1));
+}
+
+fn field(s: &State, _: &mut Cx<State>) -> El {
+    text_input(&s.edit, TextStyle::new(14.0, 400.0)).key("edit").size(200.0, 40.0)
+        .on_edit(|s: &mut State| &mut s.edit)
+}
+
+#[test]
+fn queued_focus_and_ime_stay_ahead_of_the_early_key() {
+    let mut rt = Runtime::new(State::default(), field, (300.0, 100.0), Env::new(true, 1.0));
+    rt.on_key = Some(|s, _, _| { s.keys += 1; true });
+    rt.frame(0.0);
+    let (x, y) = rt.find("edit").unwrap();
+    rt.pointer_down(x, y);
+    rt.pointer_up(x, y);
+    rt.ime(Ime::Commit("字".into()));
+    space(&mut rt, true, false);
+    assert!(dispatch(&mut rt, true));
+    assert_eq!(rt.state.edit.text, "字 ");
+    assert_eq!(rt.state.keys, 0, "the focused field takes the key, not the app");
+    rt.frame(0.0);
+    assert_eq!(rt.state.edit.text, "字 ");
+}
