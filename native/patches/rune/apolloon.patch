+        let (angle, pivot) = (l.border[1], [l.border[2], l.border[3]]);
+        out[n].border = [0.0; 4];
+        let (sin, cos) = angle.sin_cos();
+        let turn = |p: [f32; 2]| {
+            let (dx, dy) = (p[0] - pivot[0], p[1] - pivot[1]);
+            [pivot[0] + dx * cos - dy * sin, pivot[1] + dx * sin + dy * cos]
+        };
