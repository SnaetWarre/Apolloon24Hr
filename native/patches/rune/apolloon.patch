+
+pub(crate) struct FrameStage(Option<(fn(&'static str), &'static str)>);
+
+impl FrameStage {
+    #[inline(always)]
+    pub(crate) fn new(begin: &'static str, end: &'static str) -> Self {
+        let hook = FRAME_STAGE.get();
+        if let Some(hook) = hook { hook(begin); }
+        Self(hook.map(|hook| (hook, end)))
+    }
+}
+
+impl Drop for FrameStage {
+    #[inline(always)]
+    fn drop(&mut self) {
+        if let Some((hook, end)) = self.0 { hook(end); }
+    }
