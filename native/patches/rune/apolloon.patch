diff --git a/crates/rune/src/app/ack_draw.rs b/crates/rune/src/app/ack_draw.rs
new file mode 100644
index 000000000..7ce6fc466
--- /dev/null
+++ b/crates/rune/src/app/ack_draw.rs
@@ -0,0 +1,63 @@
+use super::AppHandle;
+use std::sync::{Arc, Mutex};
+
+pub(crate) type Report = Arc<dyn Fn(&'static str) + Send + Sync>;
+
+pub(crate) struct Pending {
+    enabled: bool,
+    reports: Mutex<Vec<Report>>,
+}
+
+impl Default for Pending {
+    fn default() -> Self {
+        Self::new(enabled(std::env::var("APOLLOON_ACK_DRAW").ok().as_deref()))
+    }
+}
+
+fn enabled(value: Option<&str>) -> bool { value != Some("0") }
+
+impl Pending {
+    fn new(enabled: bool) -> Self { Self { enabled, reports: Mutex::default() } }
+
+    pub(crate) fn request(&self, report: Report) {
+        if self.enabled {
+            self.reports.lock().unwrap().push(report);
+        }
+    }
+
+    pub(crate) fn waiting(&self) -> bool { !self.reports.lock().unwrap().is_empty() }
+
+    /// Whether a display-link wait may be admitted for this request. The reports stay queued
+    /// until the frame that consumes them begins, so a naturally admitted frame consumes them too.
+    #[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+    pub(crate) fn admit(&self) -> bool { self.waiting() }
+
+    pub(crate) fn begin(&self) -> Frame {
+        let frame = Frame(std::mem::take(&mut *self.reports.lock().unwrap()));
+        for report in &frame.0 { report("ack_draw_build"); }
+        frame
+    }
+}
+
+pub(crate) struct Frame(Vec<Report>);
+
+impl Frame {
+    pub(crate) fn presented(self) {
+        for report in self.0 { report("ack_draw_present"); }
+    }
+}
+
+impl<S: 'static> AppHandle<S> {
+    /// Queues one draw admission for a confirmed save answer. Ordinary wakes stay paced.
+    /// The report follows this request from enqueue to build and successful present return.
+    /// Only exact `APOLLOON_ACK_DRAW=0` disables admission; wake delivery is unchanged.
+    pub fn ack_draw(&self, report: impl Fn(&'static str) + Send + Sync + 'static) {
+        let report: Report = Arc::new(report);
+        if self.shared.core.ack_draw.enabled { report("ack_draw_enqueue"); }
+        self.shared.core.request_ack_draw(report);
+    }
+}
+
+#[cfg(test)]
+#[path = "ack_draw_tests.rs"]
+mod tests;
diff --git a/crates/rune/src/app/ack_draw_tests.rs b/crates/rune/src/app/ack_draw_tests.rs
new file mode 100644
index 000000000..f7c86b917
--- /dev/null
+++ b/crates/rune/src/app/ack_draw_tests.rs
@@ -0,0 +1,123 @@
+use super::*;
+
+fn reports() -> (Report, Arc<Mutex<Vec<&'static str>>>) {
+    let stages = Arc::new(Mutex::new(Vec::new()));
+    let recorded = stages.clone();
+    (Arc::new(move |stage| recorded.lock().unwrap().push(stage)), stages)
+}
+
+#[test]
+fn only_exact_zero_opts_out() {
+    assert!(!enabled(Some("0")));
+    for value in [None, Some(""), Some("1"), Some("false"), Some("00"), Some(" 0")] {
+        assert!(enabled(value), "{value:?}");
+    }
+}
+
+#[test]
+fn confirmed_request_is_consumed_by_one_frame_and_reports_its_boundaries() {
+    let pending = Pending::new(true);
+    let (report, stages) = reports();
+    assert!(!pending.admit());
+    pending.request(report);
+    assert!(pending.admit());
+    let frame = pending.begin();
+    assert!(!pending.admit());
+    frame.presented();
+    pending.begin().presented();
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_build", "ack_draw_present"]);
+}
+
+#[test]
+fn naturally_admitted_frame_consumes_all_coalesced_requests_without_an_extra_frame() {
+    let pending = Pending::new(true);
+    let (first, a) = reports();
+    let (second, b) = reports();
+    pending.request(first);
+    pending.request(second);
+    pending.begin().presented();
+    assert!(!pending.admit());
+    assert_eq!(*a.lock().unwrap(), *b.lock().unwrap());
+    assert_eq!(a.lock().unwrap().len(), 2);
+}
+
+#[test]
+fn ordinary_state_wakes_do_not_request_ack_admission() {
+    let mut shared = super::super::Shared::<()>::default();
+    Arc::get_mut(&mut shared.core).unwrap().ack_draw = Pending::new(true);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    handle.wake();
+    assert!(!handle.shared.ack_draw.admit());
+}
+
+#[test]
+fn opt_out_preserves_wake_without_admission_or_reports() {
+    let mut shared = super::super::Shared::<()>::default();
+    Arc::get_mut(&mut shared.core).unwrap().ack_draw = Pending::new(false);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    let (report, stages) = reports();
+    handle.ack_draw(move |stage| report(stage));
+    assert!(handle.shared.take().woken);
+    assert!(!handle.shared.ack_draw.admit());
+    handle.shared.ack_draw.begin().presented();
+    assert!(stages.lock().unwrap().is_empty());
+}
+
+#[test]
+fn admission_publishes_poll_work_before_a_frame_can_drain_the_request() {
+    let mut shared = super::super::Shared::<()>::default();
+    Arc::get_mut(&mut shared.core).unwrap().ack_draw = Pending::new(true);
+    let handle = AppHandle { shared: Arc::new(shared) };
+    let stages = Arc::new(Mutex::new(Vec::new()));
+    let recorded = stages.clone();
+    let (sender, receiver) = std::sync::mpsc::channel();
+    let requests = handle.shared.core.requests.lock().unwrap();
+    let worker_handle = handle.clone();
+    let worker = std::thread::spawn(move || {
+        worker_handle.ack_draw(move |stage| {
+            recorded.lock().unwrap().push(stage);
+            if stage == "ack_draw_enqueue" { sender.send(()).unwrap(); }
+        });
+    });
+    receiver.recv_timeout(std::time::Duration::from_secs(10)).unwrap();
+    assert!(handle.shared.ack_draw.begin().0.is_empty());
+    drop(requests);
+    worker.join().unwrap();
+    assert!(handle.shared.take().woken);
+    handle.shared.ack_draw.begin().presented();
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_enqueue", "ack_draw_build", "ack_draw_present"]);
+}
+
+#[test]
+fn ack_during_a_build_belongs_to_the_next_frame() {
+    let pending = Pending::new(true);
+    let (report, stages) = reports();
+    let previous = pending.begin();
+    pending.request(report);
+    previous.presented();
+    assert!(stages.lock().unwrap().is_empty());
+    assert!(pending.admit());
+    pending.begin().presented();
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_build", "ack_draw_present"]);
+}
+
+#[test]
+fn missed_frame_never_claims_a_present_or_rearms_admission() {
+    let pending = Pending::new(true);
+    let (report, stages) = reports();
+    pending.request(report);
+    drop(pending.begin());
+    assert_eq!(*stages.lock().unwrap(), ["ack_draw_build"]);
+    assert!(!pending.admit());
+}
+
+#[test]
+fn waiting_is_visible_until_a_frame_takes_the_request() {
+    let pending = Pending::new(true);
+    assert!(!pending.waiting());
+    let (report, _) = reports();
+    pending.request(report);
+    assert!(pending.waiting());
+    drop(pending.begin());
+    assert!(!pending.waiting());
+}
