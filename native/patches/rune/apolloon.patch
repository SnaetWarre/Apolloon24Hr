--- /dev/null
+++ b/crates/rune-text/src/profile_tests.rs
@@ -0,0 +1,48 @@
+use super::*;
+
+thread_local! {
+    static EVENTS: std::cell::RefCell<Vec<&'static str>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+fn record(name: &'static str) {
+    EVENTS.with_borrow_mut(|events| events.push(name));
+}
+
+fn reset() {
+    set_frame_stage_hook(None);
+    EVENTS.with_borrow_mut(Vec::clear);
+}
+
+fn events() -> Vec<&'static str> {
+    EVENTS.with_borrow(Vec::clone)
+}
+
+#[test]
+fn frame_stage_reports_nested_scopes_and_stops_with_the_hook() {
+    reset();
+    set_frame_stage_hook(Some(record));
+    {
+        let _atlas = FrameStage::new("atlas_begin", "atlas_end");
+        {
+            let _glyph = FrameStage::new("glyph_begin", "glyph_end");
+        }
+    }
+    set_frame_stage_hook(None);
+    drop(FrameStage::new("font_fallback_begin", "font_fallback_end"));
+
+    assert_eq!(events(), ["atlas_begin", "glyph_begin", "glyph_end", "atlas_end"]);
+}
+
+#[test]
+fn frame_stage_reports_end_on_unwind() {
+    reset();
+    set_frame_stage_hook(Some(record));
+    let caught = std::panic::catch_unwind(|| {
+        let _stage = FrameStage::new("glyph_begin", "glyph_end");
+        panic!("frame stage unwind");
+    });
+
+    assert!(caught.is_err());
+    set_frame_stage_hook(None);
+    assert_eq!(events(), ["glyph_begin", "glyph_end"]);
+}
