+
+fn parse(value: Option<&str>) -> bool { value != Some("0") }
+
+pub(super) fn dispatch(enabled: bool, queued: impl FnOnce() -> bool, drain: impl FnOnce()) -> bool {
+    if !enabled || !queued() { return false; }
+    drain();
+    true
+}
