     }
+
+    #[cfg(target_os = "linux")]
+    pub(in crate::window) fn linux_resize_edge(&self, rt: &RuntimeCore, (x, y): (f32, f32)) -> Option<winit::window::ResizeDirection> {
+        use winit::window::ResizeDirection::*;
+        if !self.client_resize || self.window.is_maximized() || self.window.fullscreen().is_some() {
+            return None;
+        }
+        let (width, height) = rt.window_viewport();
+        let (x, y) = (x * rt.zoom(), y * rt.zoom());
+        let margin = 5.0;
+        let horizontal = if x < margin { -1 } else if x >= width - margin { 1 } else { 0 };
+        let vertical = if y < margin { -1 } else if y >= height - margin { 1 } else { 0 };
+        Some(match (horizontal, vertical) {
+            (-1, -1) => NorthWest,
+            (-1, 0) => West,
+            (-1, 1) => SouthWest,
+            (0, -1) => North,
+            (0, 1) => South,
+            (1, -1) => NorthEast,
+            (1, 0) => East,
+            (1, 1) => SouthEast,
+            _ => return None,
+        })
+    }
 }
