{
  "name": "leuven-24h-runner-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "24h runner tracker for Leuven event",
  "author": "Apolloon",
  "homepage": "https://github.com/apolloon/leuven-tracker",
  "desktopName": "Leuven 24h Tracker",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev:fresh",
    "dev:vite": "vite",
    "dev:api": "cross-env PORT=3000 PUBLIC_APP_PORT=5173 tsx server/index.ts",
    "dev:all": "node scripts/ensure-lan-dev-firewall.mjs && concurrently -k \"npm run dev:api\" \"cross-env VITE_DEV_API_PORT=3000 vite\"",
    "dev:seeded": "node scripts/ensure-lan-dev-firewall.mjs && concurrently -k \"cross-env DATA_PATH=.dev-data PORT=3000 PUBLIC_APP_PORT=5173 tsx server/index.ts\" \"cross-env VITE_DEV_API_PORT=3000 vite\"",
    "dev:fresh": "npm run db:dev:seed && npm run dev:seeded",
    "dev:fresh:live": "npm run db:dev:seed:live && npm run dev:seeded",
    "dev:fresh:large": "npm run db:dev:seed:large && npm run dev:seeded",
    "tunnel:vps": "bash scripts/tunnel-vps.sh",
    "tunnel:vps:8080": "cross-env REMOTE_PORT=8080 bash scripts/tunnel-vps.sh",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "db:dev:empty": "tsx scripts/seed-test-db.mjs --scenario=empty",
    "db:dev:seed": "tsx scripts/seed-test-db.mjs --scenario=ready",
    "db:dev:seed:ready": "tsx scripts/seed-test-db.mjs --scenario=ready",
    "db:dev:seed:live": "tsx scripts/seed-test-db.mjs --scenario=live",
    "db:dev:seed:large": "tsx scripts/seed-test-db.mjs --scenario=large",
    "seed:test": "tsx scripts/seed-test-db.mjs --scenario=ready",
    "seed:test:live": "tsx scripts/seed-test-db.mjs --scenario=live",
    "client:build": "vite build && node scripts/precompress-dist.mjs",
    "server:build": "tsc -p tsconfig.server.json",
    "typecheck:client": "tsc -p tsconfig.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "test": "node --import tsx --test tests/temporary-teams.test.ts tests/core-regressions.test.ts tests/cluster-policy.test.ts tests/electron-config.test.ts",
    "test:e2e": "npm run build && node --import tsx --test tests/temporary-teams.e2e.test.ts tests/cluster.e2e.test.ts",
    "check": "npm run typecheck && npm run client:build",
    "build": "npm run typecheck:client && npm run client:build && npm run server:build",
    "preview": "vite preview",
    "electron:dev": "node scripts/ensure-lan-dev-firewall.mjs && concurrently -k \"npm run dev:seeded\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && node scripts/electron-build.mjs",
    "electron:build:win": "npm run build && node scripts/electron-build.mjs --win",
    "electron:build:linux": "npm run build && node scripts/electron-build.mjs --linux",
    "electron:build:mac": "npm run build && node scripts/electron-build.mjs --mac"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^41.2.2",
    "electron-builder": "^26.15.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.leuven24h.tracker",
    "productName": "Leuven 24h Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "public/**/*",
      ".env.example",
      "!node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/**/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/**/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asarUnpack": [
      "dist-server/**/*",
      "node_modules/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "electron@41.2.2": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  }
}
