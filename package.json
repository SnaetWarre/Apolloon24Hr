{
  "name": "apolloon-tools",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "bench:screens": "node scripts/bench/six-screens.mjs",
    "stress:race": "node scripts/stress/race.mjs",
    "dev": "bash native/scripts/prepare-rune.sh && cargo run --locked --manifest-path native/Cargo.toml",
    "build": "bash native/scripts/build-web.sh && cargo build --locked --manifest-path native/Cargo.toml",
    "test": "node --import tsx --test tests/*.test.{ts,mjs}",
    "test:native": "bash native/scripts/prepare-rune.sh && cargo test --locked --manifest-path native/Cargo.toml",
    "test:browser": "node native/scripts/check-web.mjs && node native/scripts/check-web.mjs --cpu && node native/scripts/check-failover.mjs",
    "check": "tsc -p tsconfig.json && oxlint && oxfmt --check",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "wrapped:build": "bash native/scripts/prepare-rune.sh && cargo build --manifest-path native/Cargo.toml --no-default-features --bin apolloon-native",
    "wrapped:cards": "npm run wrapped:build && tsx scripts/wrapped/run.ts cards",
    "wrapped:from-export": "npm run wrapped:build && tsx scripts/wrapped/from-export.ts",
    "wrapped:mail": "tsx scripts/wrapped/run.ts mail"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "nodemailer": "^10.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "read-excel-file": "^9.3.17",
    "smtp-server": "^3.21.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "write-excel-file": "^4.1.1"
  }
}
