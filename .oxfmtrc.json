{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "es5",
  "ignorePatterns": [
    "release",
    "public",
    "docs",
    "package-lock.json",
    "*.md",
    "*.html",
    "*.css",
    "native/.rune",
    "native/web-dist",
    "native/target"
  ],
  "sortPackageJson": false
}
